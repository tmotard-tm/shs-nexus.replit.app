    {
      "name": "suiteQL get item",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Prefer",
            "value": "transient",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"q\": \"SELECT DISTINCT vb.id AS vendor_bill_id, vb.tranid AS vendor_bill_tranid, ABS(vb.total) AS vendor_bill_total, vb.trandate AS vendor_bill_date, vb.status AS vendor_bill_status FROM nexttransactionlinelink l JOIN transaction vb ON vb.id = l.nextdoc WHERE l.previousdoc = 12399672 AND l.linktype = 'OrdBill' AND (vb.recordtype = 'VendBill' OR vb.type = 'VendBill') ORDER BY vb.trandate DESC\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
