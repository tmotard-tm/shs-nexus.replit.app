const NEWEST = `SELECT VEH, ST FROM (
  SELECT TRIM(HOLMAN_VEHICLE_NUMBER) VEH, ASSIGNED_STATUS_DESCRIPTION ST,
    ROW_NUMBER() OVER (PARTITION BY TRIM(HOLMAN_VEHICLE_NUMBER) ORDER BY UPLOAD_TIMESTAMP DESC NULLS LAST, PO_DATE DESC NULLS LAST, PO_LINE_SEQ DESC NULLS LAST) RN
