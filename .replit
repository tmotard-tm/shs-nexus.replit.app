modules = ["nodejs-20", "python-3.11", "web", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["jq"]

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 3456
externalPort = 8080

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5071
externalPort = 8008

[[ports]]
localPort = 10181

[[ports]]
localPort = 13841

[[ports]]
localPort = 21395

[[ports]]
localPort = 22024

[[ports]]
localPort = 23636
externalPort = 3000

[[ports]]
localPort = 23637

[[ports]]
localPort = 23638

[[ports]]
localPort = 23639

[[ports]]
localPort = 23640

[[ports]]
localPort = 31191

[env]
PORT = "5000"

[workflows]

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "cache-alignment-unit"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx --test tests/vehicle-61385-write-through.test.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "cache-alignment-integration"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx --test tests/vehicle-61385-integration.test.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "comms-lib-unit"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx --test tests/fleet-comms-lib.test.ts"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "artifacts/mockup-sandbox: Component Preview Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/mockup-sandbox"
isCanvasWorkflow = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
cwd = "./artifacts/mockup-sandbox"
waitForPort = 23636
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "23636"
BASE_PATH = "/__mockup/"

[agent]
integrations = ["javascript_mem_db:1.0.0", "javascript_database:1.0.0", "javascript_log_in_with_replit:1.0.0", "javascript_auth_all_persistance:1.0.0", "javascript_sendgrid:1.0.0", "javascript_object_storage:1.0.0", "javascript_openai:1.0.0", "javascript_gemini:1.0.0"]

[userenv]

[userenv.shared]
TOOL_AUDIT_EMAIL_TEST_MODE = "true"
TOOL_AUDIT_TEST_EMAIL = "stephen.wong@transformco.com"
WMS_ENGINE_BASE_URL = "https://hspsc-api-gateway.prod.nextgen.shs.com/v1/api"
BYOV_DASHBOARD_URL = "https://byovdashboard.replit.app"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000

[objectStorage]
defaultBucketID = "replit-objstore-c045591a-a89c-45b9-9118-8c388bdd00c6"
