modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["jq"]

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 10181
externalPort = 3003
exposeLocalhost = true

[[ports]]
localPort = 13841
externalPort = 5173
exposeLocalhost = true

[[ports]]
localPort = 23636
externalPort = 3000

[[ports]]
localPort = 23637
externalPort = 4200

[[ports]]
localPort = 23638
externalPort = 3002

[[ports]]
localPort = 23639
externalPort = 3001

[[ports]]
localPort = 23640
externalPort = 5000

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "cache-alignment-unit"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "cache-alignment-integration"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "cache-alignment-unit"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx --test tests/vehicle-61385-write-through.test.ts"

[[workflows.workflow]]
name = "cache-alignment-integration"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx --test tests/vehicle-61385-integration.test.ts"

[agent]
integrations = ["javascript_mem_db:1.0.0", "javascript_database:1.0.0", "javascript_log_in_with_replit:1.0.0", "javascript_auth_all_persistance:1.0.0", "javascript_sendgrid:1.0.0", "javascript_object_storage:1.0.0", "javascript_openai:1.0.0", "javascript_gemini:1.0.0"]

[userenv]

[userenv.shared]
TOOL_AUDIT_EMAIL_TEST_MODE = "true"
TOOL_AUDIT_TEST_EMAIL = "stephen.wong@transformco.com"
WMS_ENGINE_BASE_URL = "https://hspsc-api-gateway.prod.nextgen.shs.com/v1/api"
BYOV_DASHBOARD_URL = "https://byovdashboard.replit.app"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000
